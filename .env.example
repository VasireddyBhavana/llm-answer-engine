# ---------------------------------------------------------------- auth (set these!)
# Long random secret for signing login tokens:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GROUNDED_JWT_SECRET=
GROUNDED_JWT_TTL_MIN=60
# Creates the first admin on startup when no users exist yet.
GROUNDED_ADMIN_EMAIL=admin@example.com
GROUNDED_ADMIN_PASSWORD=change-me-please
GROUNDED_RATE_LIMIT_PER_MIN=60

# ---------------------------------------------------------------- model
# Default: fully offline (mock LLM + hashing embeddings). No key needed.
GROUNDED_LLM=mock
# Claude:   GROUNDED_LLM=anthropic  ANTHROPIC_API_KEY=sk-ant-...  GROUNDED_MODEL=claude-haiku-5-5
# OpenAI:   GROUNDED_LLM=openai     OPENAI_API_KEY=sk-...         GROUNDED_MODEL=gpt-4o-mini
# Ollama (free, local): GROUNDED_LLM=openai OPENAI_BASE_URL=http://localhost:11434/v1 GROUNDED_MODEL=llama3.1
# Real embeddings:      GROUNDED_EMBEDDER=openai GROUNDED_EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- retrieval
GROUNDED_RETRIEVER=hybrid          # bm25 | vector | hybrid | hybrid+rerank
GROUNDED_TOP_K=4
GROUNDED_CHUNK_SIZE=120
GROUNDED_CHUNK_OVERLAP=20
GROUNDED_MAX_UPLOAD_MB=20

# ---------------------------------------------------------------- storage
GROUNDED_DB=.grounded/grounded.db
GROUNDED_SEED_CORPUS=1             # load data/corpus as public docs on first start

# ---------------------------------------------------------------- integrations
GROUNDED_INTEGRATIONS=weather,wikipedia,webhook
# Slack-compatible incoming webhook for the post_message tool (always needs approval).
GROUNDED_WEBHOOK_URL=
GROUNDED_HTTP_TIMEOUT_S=8
