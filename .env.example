# Default: fully offline (mock LLM + hashing embeddings). No key needed.
GROUNDED_LLM=mock

# --- Use Claude ---
# GROUNDED_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# GROUNDED_MODEL=claude-haiku-5-5

# --- Use OpenAI, or any OpenAI-compatible server (Ollama, vLLM, Groq, LM Studio) ---
# GROUNDED_LLM=openai
# OPENAI_API_KEY=sk-...
# GROUNDED_MODEL=gpt-4o-mini
# Free + local with Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1  GROUNDED_MODEL=llama3.1

# --- Real embeddings (OpenAI-compatible /embeddings endpoint) ---
# GROUNDED_EMBEDDER=openai
# GROUNDED_EMBED_MODEL=text-embedding-3-small

# --- Retrieval knobs to hill-climb with `grounded eval` ---
# GROUNDED_CHUNK_SIZE=120
# GROUNDED_CHUNK_OVERLAP=20
# GROUNDED_TOP_K=4
# GROUNDED_RETRIEVER=hybrid
